{
  "contractVersion": 1,
  "kind": "instrument",
  "name": "Spec Synth",
  "vendor": "Spec acceptance test",
  "uid": "org.example.specsynth",
  "version": "0.1.0",
  "io": { "inputs": 0, "outputs": 2 },
  "latencySamples": 0,
  "tailSamples": 3840000,
  "processor": "synth.wasm",
  "maxStateBytes": 0,
  "parameters": [
    { "id": "waveform", "name": "Waveform", "type": "enum", "options": ["Sine", "Triangle", "Saw", "Square"], "default": 2 },
    { "id": "attack", "name": "Attack", "type": "float", "min": 0.001, "max": 5, "default": 0.005, "unit": "s", "skew": "log" },
    { "id": "decay", "name": "Decay", "type": "float", "min": 0.001, "max": 10, "default": 0.4, "unit": "s", "skew": "log" },
    { "id": "sustain", "name": "Sustain", "type": "float", "min": 0, "max": 1, "default": 0.6 },
    { "id": "release", "name": "Release", "type": "float", "min": 0.001, "max": 10, "default": 0.4, "unit": "s", "skew": "log" },
    { "id": "cutoff", "name": "Cutoff", "type": "float", "min": 20, "max": 20000, "default": 4000, "unit": "Hz", "skew": "log" },
    { "id": "resonance", "name": "Resonance", "type": "float", "min": 0, "max": 1, "default": 0.2 },
    { "id": "velocity", "name": "Velocity sensitive", "type": "bool", "default": true },
