{
  "contractVersion": 1,
  "kind": "effect",
  "name": "Tape Saturator",
  "vendor": "loomamusic",
  "uid": "com.loomamusic.tapesat",
  "version": "0.1.0",
  "io": { "inputs": 2, "outputs": 2 },
  "latencySamples": 192,
  "processor": "./dsp.wasm",
  "maxStateBytes": 0,
